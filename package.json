{
  "name": "quoridor-trainer",
  "version": "1.0.0",
  "description": "Quoridor Playbook & Trainer Web Application",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/test_mcts_optimizations.js && node tests/test_guaranteed_win_eval_bar.js && node tests/test_eval_consistency.js && python tests/test_model.py",
    "test:sim": "python tests/verify_simulator.py && python tests/verify_solver.py",
    "eval": "python eval/eval_suite.py",
    "predeploy": "python scripts/deploy_model.py && vite build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
