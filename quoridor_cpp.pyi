from typing import Callable, List, Optional, Set, Tuple, Dict, Any, Union
import numpy as np

class Action:
    type: str
    move_dir: str
    to_x: int
    to_y: int
    wall_type: str
    wall_x: int
    wall_y: int

    def __init__(self) -> None: ...
    @staticmethod
    def Move(move_dir: str, to_x: int, to_y: int) -> Action: ...
    @staticmethod
    def Wall(wall_type: str, wall_x: int, wall_y: int) -> Action: ...

class QuoridorGame:
    p1_pos: Tuple[int, int]
    p2_pos: Tuple[int, int]
    p1_walls_left: int
    p2_walls_left: int
    is_p1_turn: bool
    h_bitboard: int
    v_bitboard: int

    def __init__(self) -> None: ...
    def update_bitboards(self) -> None: ...
    def get_canonical_hash(self) -> Tuple[int, bool]: ...
    @staticmethod
    def mirror_bitboard_horizontal(b: int) -> int: ...
    def clone(self) -> QuoridorGame: ...
    def clone_and_step(self, action: Action) -> QuoridorGame: ...
    def is_move_blocked(self, x1: int, y1: int, x2: int, y2: int) -> bool: ...
    def get_shortest_path(self, start: Tuple[int, int], target_y: int, opp_pos: Tuple[int, int] = (-1, -1)) -> List[Tuple[int, int]]: ...
    def has_path_to_row(self, start: Tuple[int, int], target_y: int) -> bool: ...
    def get_valid_pawn_moves(self, is_p1: bool) -> List[Action]: ...
    def validate_wall_placement(self, wx: int, wy: int, wall_type: str) -> bool: ...
    def validate_wall_placement_cached(self, wx: int, wy: int, wall_type: str, p1_path: List[Tuple[int, int]], p2_path: List[Tuple[int, int]]) -> bool: ...
    def count_wall_contacts(self, wx: int, wy: int, wall_type: str) -> int: ...
    def get_candidate_walls(self) -> List[Tuple[int, int, str]]: ...
    def get_valid_actions(self) -> List[Action]: ...
    def step(self, action: Action) -> None: ...
    def is_game_over(self) -> int: ...
    def get_guaranteed_winner(self) -> int: ...
    def are_shortest_path_dags_disjoint(self) -> Tuple[bool, int, int]: ...
    def evaluate_heuristic(self) -> float: ...

    @property
    def h_walls(self) -> Set[Tuple[int, int]]: ...
    @property
    def v_walls(self) -> Set[Tuple[int, int]]: ...
    @property
    def h_wall_owners(self) -> Dict[str, int]: ...
    @property
    def v_wall_owners(self) -> Dict[str, int]: ...

class MCTS:
    c_puct: float
    dirichlet_alpha: float
    dirichlet_eps: float
    c_fpu: float
    use_gumbel: bool

    def __init__(
        self,
        c_puct: float = 1.4,
        dirichlet_alpha: float = 0.3,
        dirichlet_eps: float = 0.25,
        c_fpu: float = 0.20,
        use_gumbel: bool = False,
    ) -> None: ...
    def clear_transposition_table(self) -> None: ...
    def get_tt_size(self) -> int: ...
    @staticmethod
    def mirror_policy_cpp(policy: Union[List[float], np.ndarray]) -> List[float]: ...
    def run_search_batched(
        self,
        games: List[QuoridorGame],
        eval_cb: Callable[[np.ndarray], Tuple[np.ndarray, np.ndarray]],
        num_simulations: int,
    ) -> Tuple[List[List[int]], List[float]]: ...
    @staticmethod
    def encode_state_cpp(game: QuoridorGame) -> List[float]: ...

